{
	"name": "n8n-nodes-pollinations",
	"version": "0.1.0",
	"description": "n8n community node for Pollinations — generate text, images, video, audio, 3D models and embeddings from a single API",
	"license": "MIT",
	"homepage": "https://gen.pollinations.ai",
	"keywords": [
		"n8n-community-node-package",
		"pollinations",
		"ai",
		"text-generation",
		"image-generation",
		"video-generation",
		"text-to-speech",
		"embeddings"
	],
	"author": {
		"name": "Pollinations n8n",
		"email": "n8n-nodes-pollinations@users.noreply.github.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/your-org/n8n-nodes-pollinations.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/PollinationsApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Pollinations/Pollinations.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
